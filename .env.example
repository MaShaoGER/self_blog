# 复制为 .env.local（本地）或 .env（Docker 部署），然后填写

# 首次初始化 admin 账号的密码，至少 8 位，建议 16 位以上。
# 初始化后在后台「我的账号」或「账号管理」修改密码，改此变量不会重置已有账号。
BLOG_ADMIN_PASSWORD=

# 会话签名密钥，至少 32 位。生成方式：
#   openssl rand -base64 48
# 更换后所有设备都需要重新登录
BLOG_SESSION_SECRET=

# 站点对外地址，用于 RSS、sitemap 和分享链接（不要带末尾斜杠）
SITE_URL=https://blog.example.com

# Docker 部署时 Caddy 用来申请证书的域名（与 SITE_URL 的主机名一致）
DOMAIN=blog.example.com
