# 统一换行：仓库内文本一律 LF，避免 Windows/macOS/Linux 之间出现整文件 diff
* text=auto eol=lf

# 显式声明为文本，保证在 Linux 容器里可执行
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf

# 二进制资源，禁止换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
