# Administrator-owned shell configuration outside checkout; chmod 600.
BLOG_REPO_DIR=/opt/self_blog
BLOG_ENV_FILE=/etc/self_blog/blog.env
BLOG_HOST_DATA_DIR=/srv/self_blog/data
BLOG_STATE_DIR=/srv/self_blog/state
BLOG_DEPLOY_MODE=gateway
BLOG_COMPOSE_PROJECT_NAME=self-blog-preview
BLOG_APP_PORT=33030
BLOG_GIT_REMOTE=origin
BLOG_GIT_BRANCH=main
# HTTPS mode only:
# DOMAIN=blog.example.com
# NPM_REGISTRY=https://registry.npmmirror.com
