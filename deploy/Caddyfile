{$DOMAIN} {
	encode zstd gzip

	# Uploads are capped at 15 MB in the app; give a little headroom for multipart overhead.
	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy blog:3000 {
		# Overwrite rather than append, so clients can't spoof their IP.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
