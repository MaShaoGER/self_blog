# Existing host-network Openresty/Nginx; certificate paths belong to that gateway.
server {
    listen 127.0.0.1:9443 ssl;
    server_name localhost;
    ssl_certificate /www/ssl/self-blog-preview/fullchain.pem;
    ssl_certificate_key /www/ssl/self-blog-preview/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:33030;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
