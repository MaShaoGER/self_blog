{
  "name": "self-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/uploads.test.mjs tests/health.test.mjs tests/backup.test.mjs tests/accounts.test.mjs tests/auth-sessions.test.mjs tests/login-attempt.test.mjs tests/settings.test.mjs",
    "test:standalone": "node --test tests/standalone.test.mjs",
    "check:release": "pnpm typecheck && pnpm build && pnpm test && pnpm test:standalone && pnpm audit:release",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "audit:release": "pnpm audit --prod --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "clsx": "2.1.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "highlight.js": "11.11.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
